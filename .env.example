# Copy to .env at the workspace root (and/or apps/api/.env)
DATABASE_URL="postgresql://finance:finance@localhost:5436/finance_monitoring?schema=public"

# Nest API
PORT=3000

# Web (TanStack Start) — leave empty to use Vite proxy
VITE_API_BASE_URL=

# REQUIRED: generate a strong secret (never commit the real value)
#   openssl rand -hex 32
# The API refuses to start if JWT_SECRET is missing, shorter than 32 chars,
# or equal to a known placeholder such as "change-me-in-local-env".
JWT_SECRET=

# Comma-separated browser origins allowed for credentialed CORS (web dev server)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
